# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# ----------------------------------------
# FRONTEND SPECIFIC IGNORES (FROM frontend/.gitignore)
# ----------------------------------------

# Frontend Build Output
/frontend/dist
/frontend/dist-ssr

# Frontend Logs/Temp Files (Many are duplicated below, but keep specific ones here)
/frontend/logs
/frontend/*.local
pnpm-debug.log*
lerna-debug.log*

# ----------------------------------------
# DEPENDENCIES AND BUILD
# ----------------------------------------

# dependencies
/node_modules
/.pnp
.pnp.js

# production
/build
build/
dist/

# ----------------------------------------
# DEBUG AND TESTING
# ----------------------------------------

# testing
/coverage

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py.cover
.hypothesis/
.pytest_cache/
cover/

# ----------------------------------------
# ENVIRONMENT AND CONFIGURATION
# ----------------------------------------

# local env files
.env*.local
.env

# Environments
.env
.envrc
.venv
env/
venv/
ENV/
env.bak/
venv.bak/
**/.venv/
**/venv/
**/env/
**/ENV/

# vercel
.vercel

# next.js
/.next/
/out/

# typescript
*.tsbuildinfo
next-env.d.ts

# ----------------------------------------
# EDITOR AND OS FILES
# ----------------------------------------

# misc / OS
.DS_Store
*.pem
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Visual Studio Code (Uncommented for project-specific settings)
.vscode/*
!.vscode/extensions.json # KEEP this exception to share recommended extensions!

# PyCharm/JetBrains
#.idea/ # Uncomment if you want to ignore this IDE folder

# Cursor
.cursorignore
.cursorindexingignore

# ----------------------------------------
# PYTHON SPECIFIC IGNORES (BACKEND)
# ----------------------------------------

# Byte-compiled / optimized / DLL files
**/__pycache__/
*.py[codz]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller
*.manifest
*.spec

# Django stuff:
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal

# Flask stuff:
instance/
.webassets-cache

# Scrapy stuff:
.scrapy

# Sphinx documentation
docs/_build/

# PyBuilder
.pybuilder/
target/

# Jupyter Notebook
.ipynb_checkpoints

# IPython
profile_default/
ipython_config.py

# pyenv
# .python-version

# pipenv
#Pipfile.lock

# UV
#uv.lock

# poetry
#poetry.lock
#poetry.toml

# pdm
#pdm.lock
#pdm.toml
.pdm-python
.pdm-build/

# pixi
